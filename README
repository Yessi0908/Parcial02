```json
[
  {
    "nombre":"PanFrancés",
    "sku":"PAN-0001",
    "categoria":"Pan",
    "precio_unitario":1.25,
    "stock":120
  },
  {
    "nombre":"Croissant",
    "sku":"PAS-0101",
    "categoria":"Pastelería",
    "precio_unitario":2.75,
    "stock":60
  }
]
